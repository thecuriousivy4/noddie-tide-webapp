# Copy to .env before running anything. Both Next.js and the Prisma CLI read it.

# --- Database (required) ---------------------------------------------------
# Matches docker-compose.yml. Host port 5433 avoids clashing with a local Postgres.
DATABASE_URL="postgresql://noddie:noddie@localhost:5433/noddie?schema=public"
# Used only by `prisma migrate diff` when generating a new migration.
SHADOW_DATABASE_URL="postgresql://noddie:noddie@localhost:5433/noddie_shadow?schema=public"

# --- Identity (required) ---------------------------------------------------
# mock       simulated identity provider: username + password sign-in, RS256 tokens from a
#            local keypair, local JWKS, ciphertext prefixed dev1:. Every signed-in screen
#            carries a banner saying the identity is simulated.
# tidecloak  the live realm: per-user sign-in against TideCloak, tokens signed by the Tide
#            network, ms1: ciphertext. Requires tidecloak.json in the project root.
IDENTITY=mock

# --- TideCloak (only read when IDENTITY=tidecloak) -------------------------
KC_BASE_URL=http://localhost:8080
KC_REALM=noddie

# Issuer stamped into simulated tokens and quoted in the activity log.
# MOCK_ISSUER=https://simulated.noddie.local/realms/ridgeline-basin
